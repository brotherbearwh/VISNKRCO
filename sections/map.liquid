{%- liquid
  assign bg_image = section.settings.background_image | default: false
  assign address = section.settings.map_address | default: false
  assign api_key = section.settings.api_key | default: false

  assign section_padding = ''
  if section.settings.section_padding == 'top'
    assign section_padding = 'pb0'
  elsif section.settings.section_padding == 'bottom'
    assign section_padding = 'mt0'
  elsif section.settings.section_padding == 'none'
    assign section_padding = 'mt0 pb0'
  endif

  case section.settings.content_type
    when 'map'
      if api_key and address
        assign state = 'display-map'
      else
        assign state = 'onboarding'
      endif
    when 'image'
      if bg_image
        assign state = 'display-bg-image'
      else
        assign state = 'onboarding'
      endif
  endcase
-%}

{% assign state = state | strip %}

<section
  id="MapSection--{{ section.id }}"
  class="global__section map-section map-section--{{ state }} {{ section_padding }}"
  data-section-id="{{ section.id }}"
  data-section-type="map"
  data-aos="fade"
>
  <script data-map-config type="application/json">
    {
      "address_no_results": {{ "sections.map.address_no_results" | t | json }},
      "address_query_limit": {{ "sections.map.address_query_limit" | t | json }},
      "address_error": {{ "sections.map.address_error" | t | json }},
      "auth_error": {{ "sections.map.auth_error" | t | json }},
      "api_key": {{ api_key | json }},
      "address": {{ address | json }},
      "zoom": 12,
      "styles": [
         {
            "featureType":"water",
            "elementType":"geometry",
            "stylers":[
               {
                  "color": "#e9e9e9"
               },
               {
                  "lightness":17
               }
            ]
         },
         {
            "featureType":"landscape",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#f5f5f5"
               },
               {
                  "lightness":20
               }
            ]
         },
         {
            "featureType":"road.highway",
            "elementType":"geometry.fill",
            "stylers":[
               {
                  "color":"#ffffff"
               },
               {
                  "lightness":17
               }
            ]
         },
         {
            "featureType":"road.highway",
            "elementType":"geometry.stroke",
            "stylers":[
               {
                  "color":"#ffffff"
               },
               {
                  "lightness":29
               },
               {
                  "weight":0.2
               }
            ]
         },
         {
            "featureType":"road.arterial",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#ffffff"
               },
               {
                  "lightness":18
               }
            ]
         },
         {
            "featureType":"road.local",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#ffffff"
               },
               {
                  "lightness":16
               }
            ]
         },
         {
            "featureType":"poi",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#f5f5f5"
               },
               {
                  "lightness":21
               }
            ]
         },
         {
            "featureType":"poi.park",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#dedede"
               },
               {
                  "lightness":21
               }
            ]
         },
         {
            "elementType":"labels.text.stroke",
            "stylers":[
               {
                  "visibility":"on"
               },
               {
                  "color":"#ffffff"
               },
               {
                  "lightness":16
               }
            ]
         },
         {
            "elementType":"labels.text.fill",
            "stylers":[
               {
                  "saturation":36
               },
               {
                  "color":"#333333"
               },
               {
                  "lightness":40
               }
            ]
         },
         {
            "elementType":"labels.icon",
            "stylers":[
               {
                  "visibility":"off"
               }
            ]
         },
         {
            "featureType":"transit",
            "elementType":"geometry",
            "stylers":[
               {
                  "color":"#f2f2f2"
               },
               {
                  "lightness":19
               }
            ]
         },
         {
            "featureType":"administrative",
            "elementType":"geometry.fill",
            "stylers":[
               {
                  "color":"#fefefe"
               },
               {
                  "lightness":20
               }
            ]
         },
         {
            "featureType":"administrative",
            "elementType":"geometry.stroke",
            "stylers":[
               {
                  "color":"#fefefe"
               },
               {
                  "lightness":17
               },
               {
                  "weight":1.2
               }
            ]
         }
      ]
    }
  </script>

  {% if section.settings.heading != blank %}
    <div class="row">
      <h2 class="section-heading mb0">
        {{ section.settings.heading }}
      </h2>
    </div>
  {% endif %}

  <div class="map-section-wrapper gridlock-fluid">
    <div class="row">
      <div class="row {{ section.settings.text_position }}">
        <div class="map-section-content-wrapper desktop-3 tablet-2 mobile-3">
          <div class="map-section-content">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'heading' %}
                    <h2>{{ block.settings.heading }}</h2>
                  {% when 'text' %}
                    <div class="rte">
                      {{ block.settings.richtext }}
                    </div>
                  {% when 'button' %}
                    {% if block.settings.text != blank %}
                      {%- liquid
                        assign href = ''

                        case block.settings.link_destination
                          when 'custom_url'
                            assign href = block.settings.link | default: '#'
                          when 'google_maps'
                            assign href = 'https://maps.google.com?daddr=' | append: section.settings.map_address | escape
                        endcase
                      -%}

                      <a
                        href="{{ href }}"
                        class="button"
                        target="_blank"
                      >
                        {{ block.settings.text | escape }}
                      </a>
                    {% endif %}

                  {% else %}

                {% endcase %}
              {% endfor %}
            {% endif %}
          </div>
        </div>
        <div class="map-section-background-wrapper contained desktop-9 tablet-4 mobile-3">
          {% case section.settings.content_type %}
            {% when 'image' %}
              {% if bg_image %}
                {% liquid
                  if section.index == 1
                    assign fetch_priority = 'high'
                    assign loading = 'eager'
                  endif
                %}
                {% render 'basic-responsive-image',
                  type: bg_image,
                  width: 2400,
                  loading: loading,
                  fetchpriority: fetch_priority
                %}
              {% endif %}
            {% when 'map' %}
              <div class="map-section-container" data-map></div>

              <div class="map-section-overlay" data-map-overlay></div>
          {% endcase %}

          <div class="placeholder-background">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    #MapSection--{{ section.id }} .map-section-wrapper {
      background-color: {{ section.settings.background_color }} !important;
    }
    #MapSection--{{ section.id }} .map-section-content h2,
    #MapSection--{{ section.id }} .map-section-content p,
    #MapSection--{{ section.id }} .map-section-content a:not(.button) {
      color: {{ section.settings.text_color }} !important;
    }

    .map-section-background-wrapper img {
        object-fit: cover;
        height: 500px;
    }

    .map-section-background-wrapper .box-ratio {
        padding-bottom: 500px !important;
    }
  </style>
</section>

{% schema %}
{
  "name": "Map",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Text",
          "default": "<p>Add some text to your blog sidebar</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Button text",
          "default": "Get directions"
        },
        {
          "type": "select",
          "id": "link_destination",
          "label": "Link destination",
          "options": [
            {
              "value": "custom_url",
              "label": "Custom URL"
            },
            {
              "value": "google_maps",
              "label": "Google Maps"
            }
          ],
          "default": "google_maps",
          "info": "Choose where the button will link to"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "visible_if": "{{ block.settings.link_destination == 'custom_url' }}"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "id": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Visit Us"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Choose text position",
      "options": [
        {
          "value": "text_left",
          "label": "Left"
        },
        {
          "value": "text_right",
          "label": "Right"
        }
      ],
      "default": "text_right"
    },
    {
      "type": "header",
      "content": "Map or Image Background"
    },
    {
      "type": "select",
      "id": "content_type",
      "label": "Content type",
      "options": [
        {
          "value": "map",
          "label": "Map"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "map"
    },
    {
      "id": "api_key",
      "type": "text",
      "label": "Google maps API key",
      "info": "You’ll need to [register a Google Maps API Key](https://help.shopify.com/manual/using-themes/troubleshooting/map-section-api-key) and paste it here to display the map in the background",
      "visible_if": "{{ section.settings.content_type == 'map' }}"
    },
    {
      "id": "map_address",
      "type": "text",
      "label": "Map address",
      "info": "Google Maps will find the exact location",
      "visible_if": "{{ section.settings.content_type == 'map' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Displayed as a fallback if the map isn’t loaded",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both",
      "visible_if": "{{ settings.section_padding > 0 }}"
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background color",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000"
    }
  ],
  "presets": [
    {
      "name": "Map",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Our Hours"
          }
        },
        {
          "type": "text",
          "settings": {
            "richtext": "<p>Mon - Fri, 10am - 9pm<br/>Saturday, 11am - 9pm<br/>Sunday, 11am - 5pm</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Our Location"
          }
        },
        {
          "type": "button",
          "settings": {
            "text": "Get directions",
            "link_destination": "google_maps"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
